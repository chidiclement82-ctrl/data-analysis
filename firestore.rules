rules_version = '2';

// Security rules for the order chat. Paste this whole file into
// Firebase console → Firestore Database → Rules, then press Publish.
//
// - Each customer is signed in anonymously and can only see and write
//   their own conversation: chats/{their user id}.
// - Staff are the users listed in the admins collection (admins/{user id}).
//   They can see and reply to every conversation.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(chatId) { return signedIn() && request.auth.uid == chatId; }
    function isText(v, max) { return v is string && v.size() <= max; }

    // Fields a customer may set on their own conversation.
    function validCustomerChat(d) {
      return isText(d.name, 80) && d.name.size() > 0
        && isText(d.phone, 40) && d.phone.size() > 0
        && d.fulfilment in ['pickup', 'delivery']
        && isText(d.address, 300)
        && isText(d.lastMessage, 500)
        && d.unreadForStaff is bool
        && d.unreadForCustomer is bool;
    }

    match /admins/{uid} {
      // Staff accounts are added by hand in the Firebase console.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /chats/{chatId} {
      allow get: if isOwner(chatId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(chatId)
        && request.resource.data.keys().hasOnly(['name', 'phone', 'fulfilment', 'address', 'status',
             'createdAt', 'updatedAt', 'lastMessage', 'lastSender', 'unreadForStaff', 'unreadForCustomer'])
        && validCustomerChat(request.resource.data)
        && request.resource.data.status == 'new'
        && request.resource.data.lastSender == 'customer'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin() || (isOwner(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'fulfilment',
             'address', 'status', 'updatedAt', 'lastMessage', 'lastSender', 'unreadForStaff', 'unreadForCustomer'])
        && validCustomerChat(request.resource.data)
        // Customers can re-open an order by sending a new one, but can't mark it confirmed, ready, etc.
        && request.resource.data.status in [resource.data.status, 'new']
        && request.resource.data.lastSender in [resource.data.lastSender, 'customer']
        // Customers can only clear their own unread flag, never set it.
        && request.resource.data.unreadForCustomer in [resource.data.unreadForCustomer, false]
        && request.resource.data.updatedAt in [resource.data.updatedAt, request.time]);

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isOwner(chatId) || isAdmin();

        allow create: if exists(/databases/$(database)/documents/chats/$(chatId))
          && ((isOwner(chatId) && request.resource.data.sender == 'customer')
              || (isAdmin() && request.resource.data.sender == 'staff'))
          && request.resource.data.keys().hasOnly(['sender', 'text', 'items', 'total', 'createdAt'])
          && isText(request.resource.data.text, 2000)
          && request.resource.data.createdAt == request.time
          && (!('items' in request.resource.data)
              || (request.resource.data.items is list && request.resource.data.items.size() <= 50))
          && (!('total' in request.resource.data) || request.resource.data.total is number);

        allow update: if false;
        allow delete: if isAdmin();
      }
    }
  }
}
