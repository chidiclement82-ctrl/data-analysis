# Copy this file to .env and fill it in. Never share your .env file.

# Your TikTok username, without the @. The cartoon only ever connects to this account's LIVE.
TIKTOK_USERNAME=

# Anthropic API key for the cartoon's brain: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# The cartoon's name, what it calls you, and its personality.
CARTOON_NAME=Bobo
HOST_NAME=
CARTOON_PERSONA=a cheerful, curious, slightly cheeky cartoon who loves learning and making the chat laugh.

# Optional: a real cartoon voice from ElevenLabs (https://elevenlabs.io). Leave empty to use the browser's voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: an Euler Stream key (https://www.eulerstream.com) if TikTok connections hit the free rate limit.
EULER_API_KEY=

# Behaviour
AUTO_REPLY=true
# Seconds of quiet between automatic replies to chat
AUTO_REPLY_GAP_SECONDS=4
THANK_FOLLOWS=true
THANK_GIFTS=true
# Comma-separated words or phrases. Comments containing them are ignored.
BLOCKED_WORDS=

# AI model and how hard it thinks (low = fastest replies). Change only if you know you need to.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Web server. Keep HOST=127.0.0.1 unless you want to use the control panel from your phone,
# in which case set HOST=0.0.0.0 and choose a CONTROL_KEY (a long random password).
PORT=3000
HOST=127.0.0.1
CONTROL_KEY=
