# Copy this file to .env and fill it in. Never share your .env file.

# Your TikTok username, without the @. The cartoon only ever connects to this account's LIVE.
TIKTOK_USERNAME=

# The cartoon's brain. Fill in ONE of these:
#  - GEMINI_API_KEY: Google Gemini, free, no card: https://aistudio.google.com/apikey
#  - ANTHROPIC_API_KEY: Claude, paid: https://console.anthropic.com/settings/keys
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# The cartoon's name, what it calls you, and its personality.
CARTOON_NAME=Bobo
HOST_NAME=
CARTOON_PERSONA=a cheerful, curious, slightly cheeky cartoon who loves learning and making the chat laugh.

# Optional: a real cartoon voice from ElevenLabs (https://elevenlabs.io). Leave empty to use the browser's voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: an Euler Stream key (https://www.eulerstream.com) if TikTok connections hit the free rate limit.
EULER_API_KEY=

# Behaviour
AUTO_REPLY=true
# Seconds of quiet between automatic replies to chat
AUTO_REPLY_GAP_SECONDS=4
THANK_FOLLOWS=true
THANK_GIFTS=true
# Comma-separated words or phrases. Comments containing them are ignored.
BLOCKED_WORDS=

# Which AI to use when both keys are set: gemini or claude. Empty = whichever key you filled in.
AI_PROVIDER=
# Models. Change only if you know you need to.
GEMINI_MODEL=gemini-flash-latest
CLAUDE_MODEL=claude-opus-5-5
# How hard Claude thinks (low = fastest replies)
CLAUDE_EFFORT=low

# Web server. Keep HOST=127.0.0.1 when everything runs on this computer.
# For your phone on the same Wi-Fi, or when hosted online, use HOST=0.0.0.0 and set
# CONTROL_KEY to a long random password (12+ characters). Both pages then ask for it.
PORT=3000
HOST=127.0.0.1
CONTROL_KEY=
